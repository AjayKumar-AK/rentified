# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public "anon" key. Safe in the browser ONLY because RLS denies everything except the public views.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any long random string; salts the hash of visitor IPs used for rate limiting.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
# Protects /api/cron/expire. Vercel sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string

# --- Freshness policy (configurable defaults, not universal facts) ---
FRESHNESS_STALE_AFTER_DAYS=7
FRESHNESS_EXPIRE_AFTER_DAYS=14
ROOMMATE_PROFILE_EXPIRE_AFTER_DAYS=30

# --- Demo data (development ONLY; the seed script refuses to run unless this is true) ---
ALLOW_DEMO_SEED=false
