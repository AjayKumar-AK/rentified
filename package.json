{
  "name": "rentified",
  "version": "0.1.0",
  "private": true,
  "description": "Community-powered rental marketplace for India (Version 0.1)",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rls": "node --env-file=.env.local scripts/check-rls.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:demo:remove": "node --env-file=.env.local scripts/seed-demo.mjs --remove",
    "types:db": "supabase gen types typescript --local > src/lib/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
